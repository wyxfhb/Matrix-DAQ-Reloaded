   /begin CHARACTERISTIC RS_speed_CAN_tau "Roadspeed CAN additional low-pass"
      VALUE                                 /* Type */
      0x00147c28                            /* @ECU_Address@RS_speed_CAN_tau@0x01007A30@ */
      ECIPP_ALIGNMENT_UWORD
      327680                                /* MaxDiff */
      Compu_RS_speed_CAN_tau                /* Conversion */
      0.45084 327680                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_RS_speed_CAN_tau " "
      FORM
      "%.1"
      "ms"
      /begin FORMULA "-5 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-5/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

