   /begin CHARACTERISTIC VSFan_Taux_tau "Aux temperature low-pass tau"
      VALUE                                 /* Type */
      0x00147c9a                            /* @ECU_Address@VSFan_Taux_tau@0x01012868@ */
      ECIPP_ALIGNMENT_UWORD
      3276795                               /* MaxDiff */
      Compu_VSFan_Taux_tau                  /* Conversion */
      4.5084 3276800                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_VSFan_Taux_tau " "
      FORM
      "%.1"
      "ms"
      /begin FORMULA "-50 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-50/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

