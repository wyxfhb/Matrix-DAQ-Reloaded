ASAP2_VERSION 1 61
/begin PROJECT Econtrols_4G "4G Test"

   /begin HEADER
      "4G A2L Configuration"
      PROJECT_NO EControls4G           /* config for version control */
      VERSION "$Revision: 82130 $:"    /* config for version control */
   /end HEADER

   /begin MODULE EControls_4G_SH2A "EControls 4G"

   // The following A2ML describes the interface between our ECM and a calibration tool
   // This A2ML block provides the framework for the actual configuration in the next block
   /begin A2ML block "IF_DATA" taggedunion if_data {
      "ASAP1B_CCP" taggedstruct {      /* Description of the DAQ-Lists */
         (block "SOURCE" struct {
            struct {
               char [101];             /* Name of the DAQ-List (data acquisition list), */
                                       /* measurement source. */
                                       /* If the DAQ-Liste only supports one fixed ECU */
                                       /* sampling rate, it can be declared below */
                                       /* to achieve compatibility with the ASAP2 standard. */
                                       /* Otherwise description of the possible ECU */
                                       /* sampling rates in QP_BLOB */
               int;                    /* Period definition : Basic scaling unit in */
                                       /* CSE defined in ASAP1b (CSE=Code for Scaling Unit) */
               long;                   /* Period definition : Rate in Scaling Units */
            };
            taggedstruct {
               "DISPLAY_IDENTIFIER" char[32];
               block "QP_BLOB" struct {
                  uint;                      /* Number of the DAQ-List 0..n */
                  taggedstruct {
                     "LENGTH" uint;          /* Length of the DAQ-List, max # of ODTs */
                     "CAN_ID_VARIABLE";      /* CAN-Message-ID is variable */
                     "CAN_ID_FIXED" ulong;   /* CAN-Message-ID of the DTOs is fixed, */
                                             /* Default DTO */
                                             /* Bit31 = 1: extended Identifier */
                                             /* Bit31 = 0: standard Identifier */
                                             /* Not applied if the ECU uses the DTM-Id */
                     ("RASTER" uchar )*;     /* Supported CCP Event Channel Names of this DAQ List */
                     ("EXCLUSIVE" int )*;    /* Exclusion of other DAQ-Lists */
                     "REDUCTION_ALLOWED";    /* Data reduction possible */
                     "FIRST_PID" uchar;      /* First Packet ID (PID) of the DAQ List */
                  };
               };
            };
         } )*;

         /* Description of the available ECU Sampling Rates (Event Channels) */
         (block "RASTER" struct {
            char [101];                /* CCP Event Channel Name */
            char [9];                  /* Short Display Name of the Event Channel Name */
            uchar;                     /* Event Channel No., used for CCP START_STOP) */
            int;                       /* Period definition : basic scaling unit in CSE */
                                       /* as defined in ASAP1b */
            long;                      /* ECU sample rate of the event channel, */
                                       /* period definition based on the basic scaling unit */
            taggedstruct {
               ("EXCLUSIVE" uchar )*;  /* Exclusion of other CCP Event Channels */
            };
         })*;

         /* Group several event channels to form one combined event */
         /* e.g. group all cylinder synchronous events to one combined element */
         (block "EVENT_GROUP" struct {
            char [101];                /* Event group name */
            char [9];                  /* Short name for the event group */
            taggedstruct {
               ("RASTER" uchar )*;
            };                         /* all (CCP Event Channel Numbers for START_STOP) */
         })*;

         /* Description of the authentification process */
         block "SEED_KEY" struct {
            char[256];     /* Name of the Seed&Key DLL for CAL Priviledge, */
                           /* including file-Extension without path */
            char[256];     /* Name of the Seed&Key DLL for DAQ Priviledge, */
            char[256];     /* Name of the Seed&Key DLL for PGM Priviledge, */
         };

         /* Description of the checksum calculation process */
         block "CHECKSUM" struct {
         char[256];        /* Name of the Checksum DLL representing the ECU Algorithm, */
                           /* including file-Extension without path */
         };

         block "TP_BLOB" struct {
            uint;          /* CCP Version, High Byte: Version Low Byte : subversion (dec.) */
            uint;          /* Blob-Version,High Byte: Version Low Byte : subversion (dec.) */
            ulong;         /* CAN-Message ID for 'Transmitting to ECU (CRM)' */
                           /* Bit31 = 1: extended Identifier */
                           /* Bit31 = 0: standard Identifier */
            ulong;         /* CAN-Message ID for 'Receiving from ECU (DTM)' */
                           /* Bit31 = 1: extended Identifier */
                           /* Bit31 = 0: standard Identifier */
            uint;          /* Logical CCP-Address of the (station address) */
            uint;          /* Byte order: 1 = high Byte first, 2 = low byte first */
            taggedstruct {
               block "CAN_PARAM" struct {
                  uint;                   /* Quartz freq. of the elec. control unit */
                  uchar;                  /* BTR0 */
                  uchar;                  /* BTR1 */
               };
               "BAUDRATE" ulong;          /* Baud rate in Hz. */
               "SAMPLE_POINT" uchar;      /* sampling point of time in percent */
               "SAMPLE_RATE" uchar;       /* number of samples per Bit (1 oder 3) */
               "BTL_CYCLES" uchar;        /* number of BTL-cycles */
               "SJW" uchar;               /* SJW-parameter in BTL-cycles */
               "SYNC_EDGE" enum {
                  "SINGLE" = 0,           /* Synchronisation only on fallende edge */
                  "DUAL" = 1              /* Synchr. on falling and rising edge */
               };
               "DAQ_MODE" enum {          /* mode of cylcic data acquisition */
                  "ALTERNATING" = 0,      /* ECU is sending one ODT per cycle */
                  "BURST" = 1             /* ECU is sending a complete DAQ */
               };
               "BYTES_ONLY";              /* ECU supports max. elements of one Byte size */
                                          /* otherwise ECU supports different dataTypes */
               "RESUME_SUPPORTED";        /* ECU supports the Resume function */
               "STORE_SUPPORTED";         /* ECU supports the Store function */
               "CONSISTENCY" enum {
                  "DAQ" = 0,              /* consistency of a complete DAQ ist guaranteed */
                  "ODT" = 1               /* consistency of a complete ODT ist guaranteed */
               };
               "ADDRESS_EXTENSION" enum { /* address extension */
                  "DAQ" = 0,              /* ECU supports one Address extension per DAQ */
                  "ODT" = 1               /* ECU supports one Address extension per ODT */
               };

               block "CHECKSUM_PARAM" struct {
                  uint;                   /* checksum calculation procedure */
                                          /* standard types not yet defined, */
                                          /* if greater of equal 1000 : manufacturer specific */
                  ulong;                  /* Maximum block length used by an ASAP1a-CCP */
                                          /* command, for checksum calculation procedure */
                  taggedstruct {
                     "CHECKSUM_CALCULATION" enum {
                        "ACTIVE_PAGE" = 0,
                        "BIT_OR_WITH_OPT_PAGE" = 1
                     };
                  };
               };
               (block "DEFINED_PAGES" struct {
                  struct {
                     uint;                /* Logical No. of the memory page (1,2,..) */
                     char[101];           /* Name of the memory page */
                     uint;                /* Adress-Extension of the memory page */
                                          /* (only Low Byte significant) */
                     ulong;               /* Base address of the memory page */
                     ulong;               /* Length of the memory page in Bytes */
                  };
                  taggedstruct {
                     "RAM";               /* memory page in RAM */
                     "ROM";               /* memory page in ROM */
                     "FLASH";             /* memory page in FLASH */
                     "EEPROM";            /* memory page in EEPROM */
                     "RAM_INIT_BY_ECU";   /* memory page is initialised by ECU start-up */
                     "RAM_INIT_BY_TOOL";  /* RAM- memory page is initialised by the MCS */
                     "AUTO_FLASH_BACK";   /* RAM memory page is automatically flashed back */
                     "FLASH_BACK";        /* feature available to flash back the RAM memory page */
                     "DEFAULT";           /* memory page is standard (fallback mode) */
                  };
               } ) *;
               ( "OPTIONAL_CMD" uint )*;  /* CCP-Code of the optional command available */
                                          /* in the ECU. It is recommended to declare all */
                                          /* non-standard ECU commands here */
            };
         };

         /* for CHARACTERISTIC and AXIS_PTS and MEMORY_LAYOUT */
         "DP_BLOB" struct {
            uint;                         /* Address extension of the calibration data */
                                          /* (only Low Byte significant) */
            ulong;                        /* Base address of the calibration data */
            ulong;                        /* Number of Bytes belonging to the calibration data */
         };
         /* for MEASUREMENT */
         "KP_BLOB" struct {
            uint;                         /* Address extension of the online data */
                                          /* (only Low Byte significant) */
            ulong;                        /* Base address of the online data */
            ulong;                        /* Number of Bytes belonging to the online data (1,2 or 4)*/
            taggedstruct {
               ("RASTER" uchar )*;        /* Array of event channel initialization values */
            };
         };
      };
   }; /end A2ML

   /begin MOD_COMMON ""
      DEPOSIT ABSOLUTE
      BYTE_ORDER MSB_FIRST
   /end MOD_COMMON

   // IF_DATA is short for InterFace data. The following blocks CONFIGURE the interface
   // between our ECM and a calibration tool. The A2ML block above provides the
   // framework for the configuration below.
   /begin IF_DATA ASAP1B_CCP

      // Describe the DAQs
      /* 1st DAQ */
      /begin SOURCE
         "100 ms DAQ"                  /* DAQ LIST NAME */
         3                             /* Period definition : Basic scaling unit= 1ms */
         100                           /* Period definition : Rate in Scaling Units */
         /begin QP_BLOB
            3                          /* Number of the DAQ-List */
            LENGTH 10                  /* Length of the DAQ-List; Max ODTs */
            CAN_ID_FIXED 0x8cff5200    /* CAN-Message-ID is fixed */
            FIRST_PID 30               /* First Packet ID (PID) of the DAQ List */
            RASTER 0                   /* Raster ID */
         /end QP_BLOB
      /end SOURCE

      /* 2nd DAQ */
      /begin SOURCE
         "50 ms DAQ"                   /* DAQ LIST NAME */
         3                             /* Period definition : Basic scaling unit= 1ms */
         50                            /* Period definition : Rate in Scaling Units */
         /begin QP_BLOB
            2                          /* Number of the DAQ-List */
            LENGTH 10                  /* Length of the DAQ-List; Max ODTs */
            CAN_ID_FIXED 0x8cff5200    /* CAN-Message-ID is fixed */
            FIRST_PID 20               /* First Packet ID (PID) of the DAQ List */
            RASTER 1                   /* Raster ID */
         /end QP_BLOB
      /end SOURCE

      /* 3rd DAQ */
      /begin SOURCE
         "10 ms DAQ"                   /* @config@ DAQ LIST NAME */
         3                             /* Period definition : Basic scaling unit= 1ms */
         10                            /* @config@ Period definition : Rate in Scaling Units */
         /begin QP_BLOB
            1                          /* Number of the DAQ-List */
            LENGTH 10                  /* @config@ Length of the DAQ-List; Max ODTs */
            CAN_ID_FIXED 0x8cff5200    /* CAN-Message-ID is fixed */
            FIRST_PID 10               /* First Packet ID (PID) of the DAQ List */
            RASTER 2                   /* Raster ID */
        /end QP_BLOB
      /end SOURCE

      /* 4th DAQ */
      /begin SOURCE
         "1 ms DAQ"                    /* DAQ LIST NAME */
         3                             /* Period definition : Basic scaling unit = 1ms */
         1                             /* Period definition : Rate in Scaling Units */
         /begin QP_BLOB
            0                          /* Number of the DAQ-List */
            LENGTH 2                   /* Length of the DAQ-List; Max ODTs */
            CAN_ID_FIXED 0x8cff5200    /* CAN-Message-ID is fixed */
            FIRST_PID 0                /* First Packet ID (PID) of the DAQ List */
            RASTER 3                   /* Raster ID */
         /end QP_BLOB
      /end SOURCE

      // Describe the RASTERS (timing) for the DAQs
      /begin RASTER
         "100ms time synchronous event channel" /* Channel Name */
         "100_ms"                               /* Display Name */
         0                                      /* Raster Number */
         4                                      /* Time Scale: 4 --> 10 ms */
         10                                     /* 10 x 10ms = 100ms */
      /end RASTER

      /begin RASTER
         "50ms time synchronous event channel"  /* Channel Name */
         "50_ms"                                /* Display Name */
         1                                      /* Raster Number */
         4                                      /* Time Scale: 4 --> 10 ms */
         5                                      /* 5 x 10ms = 50ms */
      /end RASTER

      /begin RASTER
         "10 ms time synchronous event channel" /* @config@ Channel Name */
         "10 ms"                                /* @config@ Display Name */
         2                                      /* Raster Number */
         3                                      /* Time Scale: 3 --> 1 ms */
         10                                     /* @config@ 10 x 1ms = 10ms */
      /end RASTER

      /begin RASTER
         "1ms time synchronous event channel"   /* Channel Name */
         "1_ms"                                 /* Display Name */
         3                                      /* Raster Number */
         3                                      /* Time Scale: 3 --> 1 ms */
         1                                      /* 1 x 1ms = 1ms */
      /end RASTER

      /begin TP_BLOB
         0x201                      /* CCP Version */
         0x202                      /* BLOB Version */
         0x8cff50f9                 /* CAN-Message ID for Transmitting to ECU */
         0x8CFF5100                 /* @config@CAN-Message-ID for Receiving from ECU (ID=0) */
         0x1                        /* Logical CCP Address of the station */
         0x1                        /* Byte Order = High Byte First */
         /begin CAN_PARAM
            0x0FA                   /* @config@Baud-Rate: 0x0FA=250k 0x1F4=500k 0x3E8=1M */
            0x41                    /* BTR0 */
            0x25                    /* BTR1 */
         /end CAN_PARAM
				BAUDRATE 250000

         DAQ_MODE BURST             /* ECU is sending a complete DAQ */
         //STORE_SUPPORTED          /* Not Supported by INCA */
         CONSISTENCY DAQ            /* consistency of a complete DAQ list guaranteed */
         ADDRESS_EXTENSION DAQ      /* ECU supports only one Address extension within a DAQ */

         // Description of the checksum calculation process
         /begin CHECKSUM_PARAM
            0x8003                  /* ENUM for checksum calculation procedure M_32_BIT_BY_ADD8 */
            0x4000                  /* Maximum block length */
            CHECKSUM_CALCULATION ACTIVE_PAGE
         /end CHECKSUM_PARAM

         // Configure Working Page (WP) and Reference Page (RP)
         /begin DEFINED_PAGES
            1                       /* Logical No. of the memory page (1,2,..) */
            "working page"          /* Name of the memory page */
            0                       /* Address-Extension of the memory page */
            0                       /* Address of the working page */
            0                       /* Size of the working page */
            RAM                     /* memory page in RAM */
            RAM_INIT_BY_ECU         /* memory page is initialised by ECU start-up */
         /end DEFINED_PAGES

         /* config WP/RP: INSERT Reference Page Block Below to enable WP/RP */
         /begin DEFINED_PAGES
            2                       /* Logical No. of the memory page (1,2,..) */
            "reference page"        /* Name of the memory page */
            1                       /* Address-Extension of the memory page */
            1                       /* Address of the reference page */
            0                       /* Size of the reference page */
            FLASH                   /* memory page in RAM */
         /end DEFINED_PAGES

         // It is recommended to declare all non-standard CCP commands supported by the ECU
         OPTIONAL_CMD 0x0C          /* ECU supports SET_S_STATUS */
         OPTIONAL_CMD 0x0D          /* ECU supports GET_S_STATUS */
         OPTIONAL_CMD 0x0E          /* ECU supports BUILD_CHKSUM */
         OPTIONAL_CMD 0x12          /* ECU supports GET_SEED */
         OPTIONAL_CMD 0x13          /* ECU supports UNLOCK */
         OPTIONAL_CMD 0x08          /* ECU supports START_STOP_ALL */
         OPTIONAL_CMD 0x09          /* ECU supports GET_ACTIVE_CAL_PAGE */
         OPTIONAL_CMD 0x11          /* ECU supports SELECT_CAL_PAGE */
         OPTIONAL_CMD 0x19          /* MOVE */
      /end TP_BLOB

      // Describe the authentication (seed and key) process
      /begin SEED_KEY
         "PSIR2_CCP_CAL_OEM.dll"     /* Name of the Seed&Key DLL for CAL Priviledge */
         "PSIR2_CCP_DAQ_OEM.dll"     /* Name of the Seed&Key DLL for DAQ Priviledge */
         ""                         /* Default to no PGM DLL: Name of the Seed&Key DLL for PGM Priviledge */
      /end SEED_KEY

   /end IF_DATA

   /begin MOD_PAR "SH2A-4G"
      CUSTOMER "Reserved"
      CUSTOMER_NO "C001"            /* config custerom ID? */
      ECU "4G"
      PHONE_NO "210-495-9772"
      SUPPLIER "EControls"
      USER "EControls Customer"
      VERSION "V00001"              /* config */
      //ADDR_EPK 0xfff88869         /* config */
      //EPK "xxxx-"                 /* config */

      // configure memory segments
      /begin MEMORY_SEGMENT ApplicationCode "EControls Application Code"
         CODE FLASH INTERN
         0x00010000 0x00130000      /* config @ECU_Address@SECTION=CAppHeader@ */
         -1 -1 -1 -1 -1
      /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT DCalibration "ECIPP Calibration Data"
         DATA FLASH INTERN
         0x00140000 0x00009c62      /* config @ECU_Address@SECTION=DCalibration@ */
         -1 -1 -1 -1 -1
      /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT CStaticCalibration "ECIPP Static Calibration"
         OFFLINE_DATA FLASH INTERN  /* OFF_LINE allows    Calibration of CStatic, but breaks download */
         //RESERVED FLASH INTERN    /* RESREVED prohibits Calibration of CStatic, but keeps INCA from trying to download to CStatic */
         0x00160000 0x00011600      /* config @ECU_Address@SECTION=CStaticCalibration@ */
         -1 -1 -1 -1 -1
      /end MEMORY_SEGMENT

   /end MOD_PAR

   // Define the Record Layouts
   /begin RECORD_LAYOUT ECIPP_ALIGNMENT_UBYTE
      FNC_VALUES 1 UBYTE COLUMN_DIR DIRECT
   /end RECORD_LAYOUT
   /begin RECORD_LAYOUT ECIPP_Lookup_UBYTE
      AXIS_PTS_X 1 UBYTE INDEX_INCR DIRECT
   /end RECORD_LAYOUT

   /begin RECORD_LAYOUT ECIPP_ALIGNMENT_SBYTE
      FNC_VALUES 1 SBYTE COLUMN_DIR DIRECT
   /end RECORD_LAYOUT
   /begin RECORD_LAYOUT ECIPP_Lookup_SBYTE
      AXIS_PTS_X 1 SBYTE INDEX_INCR DIRECT
   /end RECORD_LAYOUT

   /begin RECORD_LAYOUT ECIPP_ALIGNMENT_UWORD
      FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
   /end RECORD_LAYOUT
   /begin RECORD_LAYOUT ECIPP_Lookup_UWORD
      AXIS_PTS_X 1 UWORD INDEX_INCR DIRECT
   /end RECORD_LAYOUT

   /begin RECORD_LAYOUT ECIPP_ALIGNMENT_SWORD
       FNC_VALUES 1 SWORD COLUMN_DIR DIRECT
   /end RECORD_LAYOUT
   /begin RECORD_LAYOUT ECIPP_Lookup_SWORD
       AXIS_PTS_X 1 SWORD INDEX_INCR DIRECT
   /end RECORD_LAYOUT

   /begin RECORD_LAYOUT ECIPP_ALIGNMENT_ULONG
       FNC_VALUES 1 ULONG COLUMN_DIR DIRECT
   /end RECORD_LAYOUT
   /begin RECORD_LAYOUT ECIPP_Lookup_ULONG
       AXIS_PTS_X 1 ULONG INDEX_INCR DIRECT
   /end RECORD_LAYOUT

   /begin RECORD_LAYOUT ECIPP_ALIGNMENT_SLONG
       FNC_VALUES 1 SLONG COLUMN_DIR DIRECT
   /end RECORD_LAYOUT
   /begin RECORD_LAYOUT ECIPP_Lookup_SLONG
       AXIS_PTS_X 1 SLONG INDEX_INCR DIRECT
   /end RECORD_LAYOUT

   /begin RECORD_LAYOUT ECIPP_ALIGNMENT_FLOAT32_IEEE
       FNC_VALUES 1 FLOAT32_IEEE COLUMN_DIR DIRECT
   /end RECORD_LAYOUT
   /begin RECORD_LAYOUT ECIPP_Lookup_FLOAT32_IEEE
       AXIS_PTS_X 1 FLOAT32_IEEE INDEX_INCR DIRECT
   /end RECORD_LAYOUT

   // Define generic COMPU_METHODS used in the A2L
   // NOTE: most of the parameters from ECIPP use unique/specific COMPU_METHODS
   /begin COMPU_METHOD Compu_ECIPP_STRINGS
      "ECIPP Strings "           /* Identifier */
      RAT_FUNC                   /* Conversion */
      "%.0"                      /* Format */
      "ASCII"                    /* Units */
      COEFFS 0 1 0 0 0 1
   /end COMPU_METHOD
   /begin COMPU_METHOD Compu_IDENTITY
      "Discrete Values "         /* Identifier */
      IDENTICAL                  /* Conversion */
      "%.0"                      /* Format */
      "-"                        /* Units */
   /end COMPU_METHOD

   
   // Describe the special address used to COPY RCalibration (RAM) to DCalibration (FLASH)
   // CCP_CMT_ADDR=0x06000000 CCP_CMD_CMD=0x5A=90 CCP_REL_CMD=0xA5
   /begin COMPU_METHOD Compu_DirtyCal_VTAB
      "Verbal Table"
      TAB_VERB  "%8.0" ""
      COMPU_TAB_REF Compu_DirtyCal_VTAB_REF
   /end COMPU_METHOD
   /begin COMPU_VTAB Compu_DirtyCal_VTAB_REF
      "Verbal Table"
      TAB_VERB 2
      0 "RAM-EEPROM Mismatch"
      1 "RAM-EEPROM Match"
      DEFAULT_VALUE "Undefined"
   /end COMPU_VTAB
   /begin MEASUREMENT
      DirtyCalibration "Calibration RAM Data is changed"
      UBYTE
      Compu_DirtyCal_VTAB
      0 0                        /* Resolution and Accuracy */
      0 255                      /* Limits */
      ECU_ADDRESS 0x06000000
   /end MEASUREMENT

   /**********************************************************/
   /*                                                        */
   /* The remainder of this file is created programmatically */
   /* By merging A2L files from the Simulink model and ECIPP */
   /* and updating ECU Addresses using the MAP File          */
   /*                                                        */
   /**********************************************************/


/**** Merging: 4G_CCP_ECIPP.a2l ****/

   /*******************************************************************
    * DO NOT CHANGE THIS FILE - It is auto-generated by ECIPP.xlsm
    * 
    * This file contains the A2L for ECIPP Parameters 
    *
    * PROJECT_NO XLS: 577A
    * VERSION - Software Revision:  23 
    *******************************************************************/

   /begin MEASUREMENT rpm "Engine Speed"
      UWORD                                 /* Type */
      Compu_rpm                             /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      0 65535                               /* Limits */
      ECU_ADDRESS 0x01000000
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_rpm " "
      RAT_FUNC
      "%.0"
      "rpm"
      COEFFS 0 1 0 0 0 1
   /end COMPU_METHOD

   /begin MEASUREMENT MAPressure "Manifold Pressure"
      UWORD                                 /* Type */
      Compu_MAPressure                      /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      0 255.99609375                        /* Limits */
      ECU_ADDRESS 0x01000008
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_MAPressure " "
      RAT_FUNC
      "%.2"
      "psia"
      COEFFS 0 256 0 0 0 1
   /end COMPU_METHOD

   /begin MEASUREMENT ECT "Coolant Temperature"
      UWORD                                 /* Type */
      Compu_ECT                             /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      -460 563.984375                       /* Limits */
      ECU_ADDRESS 0x01000010
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_ECT " "
      RAT_FUNC
      "%.1"
      "deg F"
      COEFFS 0 64 29440 0 0 1
   /end COMPU_METHOD

   /begin MEASUREMENT MAT "Manifold Temperature"
      UWORD                                 /* Type */
      Compu_MAT                             /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      -460 563.984375                       /* Limits */
      ECU_ADDRESS 0x01000018
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_MAT " "
      RAT_FUNC
      "%.1"
      "deg F"
      COEFFS 0 64 29440 0 0 1
   /end COMPU_METHOD

   /begin MEASUREMENT spk_adv "Total Spark Advance"
      SWORD                                 /* Type */
      Compu_spk_adv                         /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      -2048 2047.9375                       /* Limits */
      ECU_ADDRESS 0x01000020
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_spk_adv " "
      RAT_FUNC
      "%.1"
      "CAD BTDC"
      COEFFS 0 16 0 0 0 1
   /end COMPU_METHOD

   /begin MEASUREMENT spk_adv_base "Base Spark Advance"
      SWORD                                 /* Type */
      Compu_spk_adv_base                    /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      -2048 2047.9375                       /* Limits */
      ECU_ADDRESS 0x01000028
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_spk_adv_base " "
      RAT_FUNC
      "%.1"
      "CAD BTDC"
      COEFFS 0 16 0 0 0 1
   /end COMPU_METHOD

   /begin MEASUREMENT spk_max_ECT "CHT Max Advance"
      SWORD                                 /* Type */
      Compu_spk_max_ECT                     /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      -2048 2047.9375                       /* Limits */
      ECU_ADDRESS 0x01000030
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_spk_max_ECT " "
      RAT_FUNC
      "%.1"
      "CAD BTDC"
      COEFFS 0 16 0 0 0 1
   /end COMPU_METHOD

   /begin MEASUREMENT spk_off_ECTvL "CHT-MAP Adv Offset"
      SWORD                                 /* Type */
      Compu_spk_off_ECTvL                   /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      -2048 2047.9375                       /* Limits */
      ECU_ADDRESS 0x01000038
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_spk_off_ECTvL " "
      RAT_FUNC
