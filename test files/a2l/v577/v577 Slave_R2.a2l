   /begin CHARACTERISTIC Tbst_WGAcmd_FF "WGP Feedforward Command"
      MAP                                   /* Type */
      0x00145B3A                            /* @ECU_Address@Tbst_WGAcmd_FF@0x02583000@ */
      ECIPP_ALIGNMENT_SWORD
      100                                   /* MaxDiff */
      Compu_Tbst_WGAcmd_FF                  /* Conversion */
      -100 99.9969482421875                 /* Limits */
      /begin AXIS_DESCR COM_AXIS
         NO_INPUT_QUANTITY
         Compu_Tbst_Ptarg_ldcmd             /* Conversion */
         8                                  /* NumAxisPts */
         -200 199.993896484375              /* Limits */
         AXIS_PTS_REF Tbst_Ptarg_ldcmd
      /end AXIS_DESCR
      /begin AXIS_DESCR COM_AXIS
         NO_INPUT_QUANTITY
         Compu_Tbst_Ptarg_rpm
         8                                  /* NumAxisPts */
         -32768 32767                       /* Limits */
         AXIS_PTS_REF Tbst_Ptarg_rpm
      /end AXIS_DESCR
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_Tbst_WGAcmd_FF ""
      RAT_FUNC
