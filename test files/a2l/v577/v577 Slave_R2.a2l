   /begin CHARACTERISTIC crank_mag_inc_tau "crank mag trig inc tau"
      VALUE                                 /* Type */
      0x00149604                            /* @ECU_Address@crank_mag_inc_tau@0x01007560@ */
      ECIPP_ALIGNMENT_UWORD
      41943                                 /* MaxDiff */
      Compu_crank_mag_inc_tau               /* Conversion */
      0.0006557704 41943.04                 /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_crank_mag_inc_tau " "
      FORM
      "%.1"
      "ms"
      /begin FORMULA "-0.01 / log(1 - (X1 / 4194304))"
         FORMULA_INV "(1 - exp(-0.01/X1)) * 4194304"
      /end FORMULA
   /end COMPU_METHOD

