   /begin CHARACTERISTIC FRT_est_tau "FRT estimation tau"
      VALUE                                 /* Type */
      0x00147bee                            /* @ECU_Address@FRT_est_tau@0x01003DD0@ */
      ECIPP_ALIGNMENT_UWORD
      3277                                  /* MaxDiff */
      Compu_FRT_est_tau                     /* Conversion */
      0.0045084 3276.8                      /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_FRT_est_tau " "
      FORM
      "%.1"
      "sec"
      /begin FORMULA "-0.05 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-0.05/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

