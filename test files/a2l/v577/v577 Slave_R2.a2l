   /begin CHARACTERISTIC MAPdt_MAPss_tau "MAP steady-state tau for trigger lookup"
      VALUE                                 /* Type */
      0x00147c06                            /* @ECU_Address@MAPdt_MAPss_tau@0x01003850@ */
      ECIPP_ALIGNMENT_UWORD
      327680                                /* MaxDiff */
      Compu_MAPdt_MAPss_tau                 /* Conversion */
      0.45084 327680                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_MAPdt_MAPss_tau " "
      FORM
      "%.1"
      "ms"
      /begin FORMULA "-5 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-5/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

