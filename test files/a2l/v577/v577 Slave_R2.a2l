   /begin CHARACTERISTIC KNK_FSO_win_peak_tau "Knock FSO window peak tau"
      VALUE                                 /* Type */
      0x00147bfc                            /* @ECU_Address@KNK_FSO_win_peak_tau@0x01010358@ */
      ECIPP_ALIGNMENT_UWORD
      327680                                /* MaxDiff */
      Compu_KNK_FSO_win_peak_tau            /* Conversion */
      0.45084 327680                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_KNK_FSO_win_peak_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-5 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-5/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

