   /begin CHARACTERISTIC EMWT_sensor_tau "EMWT sensor time constant"
      VALUE                                 /* Type */
      0x00148DD0                            /* @ECU_Address@EMWT_sensor_tau@0x01004908@ */
      ECIPP_ALIGNMENT_UWORD
      3276795                               /* MaxDiff */
      Compu_EMWT_sensor_tau                 /* Conversion */
      4.5084 3276800                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_EMWT_sensor_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-50 / log(1 - (X1 / 65536))"
