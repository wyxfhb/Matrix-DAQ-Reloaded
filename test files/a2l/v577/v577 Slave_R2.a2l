   /begin CHARACTERISTIC FIP_tau "FIP raw low-pass"
      VALUE                                 /* Type */
      0x00147be0                            /* @ECU_Address@FIP_tau@0x0100FD10@ */
      ECIPP_ALIGNMENT_UWORD
      327680                                /* MaxDiff */
      Compu_FIP_tau                         /* Conversion */
      0.45084 327680                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_FIP_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-5 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-5/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

