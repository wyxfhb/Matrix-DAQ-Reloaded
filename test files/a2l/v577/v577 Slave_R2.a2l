   /begin CHARACTERISTIC EGR_vlv_tau "EGR PWM position feedback tau"
      VALUE                                 /* Type */
      0x00140990                            /* @ECU_Address@EGR_vlv_tau@0x01009E48@ */
      ECIPP_ALIGNMENT_UWORD
      327680                                /* MaxDiff */
      Compu_EGR_vlv_tau                     /* Conversion */
      0.45084 327680                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_EGR_vlv_tau " "
      FORM
      "%.1"
      "ms"
      /begin FORMULA "-5 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-5/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

