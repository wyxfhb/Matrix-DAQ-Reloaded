   /begin CHARACTERISTIC TC_N_tau "Turbo speed low-pass tau"
      VALUE                                 /* Type */
      0x00147c30                            /* @ECU_Address@TC_N_tau@0x0100A058@ */
      ECIPP_ALIGNMENT_UWORD
      327680                                /* MaxDiff */
      Compu_TC_N_tau                        /* Conversion */
      0.45084 327680                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_TC_N_tau " "
      FORM
      "%.1"
      "ms"
