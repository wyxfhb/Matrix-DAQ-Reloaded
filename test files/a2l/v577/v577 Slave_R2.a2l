   /begin CHARACTERISTIC EGR_dmdot_cmd_tau "EGR flow command dt low-pass"
      VALUE                                 /* Type */
      0x00140988                            /* @ECU_Address@EGR_dmdot_cmd_tau@0x010107C0@ */
      ECIPP_ALIGNMENT_UWORD
      327680                                /* MaxDiff */
      Compu_EGR_dmdot_cmd_tau               /* Conversion */
      0.45084 327680                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_EGR_dmdot_cmd_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-5 / log(1 - (X1 / 65536))"
