   /begin CHARACTERISTIC inj_timing_dz_tau "Injection timing dead-zone tau"
      VALUE                                 /* Type */
      0x0014905E                            /* @ECU_Address@inj_timing_dz_tau@0x01005298@ */
      ECIPP_ALIGNMENT_UWORD
      163840                                /* MaxDiff */
      Compu_inj_timing_dz_tau               /* Conversion */
      0.16703 163840                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_inj_timing_dz_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-5 / log(1.0000000000001 - (X1 / 32768))"
         FORMULA_INV "(1.0000000000001 - exp(-5/X1)) * 32768"
      /end FORMULA
   /end COMPU_METHOD

