   /begin CHARACTERISTIC ERWT_sensor_tau "ERWT sensor time constant"
      VALUE                                 /* Type */
      0x00148DE8                            /* @ECU_Address@ERWT_sensor_tau@0x01005008@ */
      ECIPP_ALIGNMENT_UWORD
      3276795                               /* MaxDiff */
      Compu_ERWT_sensor_tau                 /* Conversion */
      4.5084 3276800                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_ERWT_sensor_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-50 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-50/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

