   /begin CHARACTERISTIC TIPAdapt_MAP_tau "MAP low pass tau"
      VALUE                                 /* Type */
      0x0014937A                            /* @ECU_Address@TIPAdapt_MAP_tau@0x0100D178@ */
      ECIPP_ALIGNMENT_UWORD
      3277                                  /* MaxDiff */
      Compu_TIPAdapt_MAP_tau                /* Conversion */
      0.0045084 3276.8                      /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_TIPAdapt_MAP_tau " "
      FORM
      "%.1"
      "sec"
      /begin FORMULA "-0.05 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-0.05/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

