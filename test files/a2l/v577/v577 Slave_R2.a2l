   /begin MEASUREMENT PAUX_LP_tau "Auxiliary pressure low-pass"
      UWORD                                 /* Type */
      Compu_PAUX_LP_tau                     /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      0.45084 327680                        /* Limits */
      ECU_ADDRESS 0x010097C0
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_PAUX_LP_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-5 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-5/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

   /begin MEASUREMENT TAUX_LP_tau "Auxiliary temp low-pass"
      UWORD                                 /* Type */
      Compu_TAUX_LP_tau                     /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      4.5084 3276800                        /* Limits */
      ECU_ADDRESS 0x010097C8
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_TAUX_LP_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-50 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-50/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

