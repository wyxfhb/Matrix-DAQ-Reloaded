      0.16703 163840                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_CVPAUX2_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-5 / log(1.0000000000001 - (X1 / 32768))"
