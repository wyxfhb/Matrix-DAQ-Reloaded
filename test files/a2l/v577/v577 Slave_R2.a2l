   /begin CHARACTERISTIC CRI_Prail_targdz_LP "Rail pressure target deadzone tau"
      VALUE                                 /* Type */
      0x0016c828                            /* @ECU_Address@CRI_Prail_targdz_LP@0x0100B6B8@ */
      ECIPP_ALIGNMENT_UWORD
      65536                                 /* MaxDiff */
      Compu_CRI_Prail_targdz_LP             /* Conversion */
      0.090168 65536                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_CRI_Prail_targdz_LP " "
      FORM
      "%.1"
      "ms"
      /begin FORMULA "-1 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-1/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

