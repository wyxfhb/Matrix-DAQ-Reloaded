   /begin CHARACTERISTIC LP_UEGO "UEGO low-pass"
      VALUE                                 /* Type */
      0x001650fa                            /* @ECU_Address@LP_UEGO@0x01001250@ */
      ECIPP_ALIGNMENT_UWORD
      327680                                /* MaxDiff */
      Compu_LP_UEGO                         /* Conversion */
      0.45084 327680                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_LP_UEGO " "
      FORM
      "%.1"
      "ms"
      /begin FORMULA "-5 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-5/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

