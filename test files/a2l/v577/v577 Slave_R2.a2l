   /begin CHARACTERISTIC cam_pos_tau "Cam position estimation filter"
      VALUE                                 /* Type */
      0x00147cb6                            /* @ECU_Address@cam_pos_tau@0x01003570@ */
      ECIPP_ALIGNMENT_UWORD
      1638398                               /* MaxDiff */
      Compu_cam_pos_tau                     /* Conversion */
      1.6703 1638400                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_cam_pos_tau " "
      FORM
      "%.0"
      "ms"
      /begin FORMULA "-50 / log(1.0000000000001 - (X1 / 32768))"
         FORMULA_INV "(1.0000000000001 - exp(-50/X1)) * 32768"
      /end FORMULA
   /end COMPU_METHOD

