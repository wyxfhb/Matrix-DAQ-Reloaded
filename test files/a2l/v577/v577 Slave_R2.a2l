   /begin MEASUREMENT ICAV_pct_tau "ICAV tau"
      UWORD                                 /* Type */
      Compu_ICAV_pct_tau                    /* Conversion */
      0 0                                   /* Resolution and Accuracy */
      0.090168 65536                        /* Limits */
      ECU_ADDRESS 0x01005108
   /end MEASUREMENT
   /begin COMPU_METHOD Compu_ICAV_pct_tau " "
      FORM
      "%.0"
      "cycles"
      /begin FORMULA "-1 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-1/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

   /begin CHARACTERISTIC ICAV_cts_tau "Continuous indicator tau"
