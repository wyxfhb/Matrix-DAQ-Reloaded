   /begin CHARACTERISTIC OILTL_level_tau "Oil T/L low pass tau"
      VALUE                                 /* Type */
      0x00147c22                            /* @ECU_Address@OILTL_level_tau@0x01010928@ */
      ECIPP_ALIGNMENT_UWORD
      3277                                  /* MaxDiff */
      Compu_OILTL_level_tau                 /* Conversion */
      0.0045084 3276.8                      /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_OILTL_level_tau " "
      FORM
      "%.1"
      "seconds"
      /begin FORMULA "-0.05 / log(1 - (X1 / 65536))"
         FORMULA_INV "(1 - exp(-0.05/X1)) * 65536"
      /end FORMULA
   /end COMPU_METHOD

