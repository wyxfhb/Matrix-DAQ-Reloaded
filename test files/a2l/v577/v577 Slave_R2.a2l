      ECIPP_ALIGNMENT_UWORD
      32768                                 /* MaxDiff */
      Compu_ICAV_cts_tau                    /* Conversion */
      0.033406 32768                        /* Limits */
   /end CHARACTERISTIC
   /begin COMPU_METHOD Compu_ICAV_cts_tau " "
      FORM
      "%.0"
      "cycles"
      /begin FORMULA "-1 / log(1.0000000000001 - (X1 / 32768))"
         FORMULA_INV "(1.0000000000001 - exp(-1/X1)) * 32768"
      /end FORMULA
   /end COMPU_METHOD

